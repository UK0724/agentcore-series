{
  "openapi": "3.0.0",
  "info": {
    "title": "Team API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:4002"
    }
  ],
  "paths": {
    "/people/{username}": {
      "get": {
        "operationId": "getPerson",
        "description": "A person: name, team, on-call status.",
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "description": "Username, like priya",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
