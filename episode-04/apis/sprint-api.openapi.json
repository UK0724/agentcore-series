{
  "openapi": "3.0.0",
  "info": {
    "title": "Sprint API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:4001"
    }
  ],
  "paths": {
    "/sprints/{sprintId}": {
      "get": {
        "operationId": "getSprint",
        "description": "Sprint velocity, days left, blocking bugs.",
        "parameters": [
          {
            "name": "sprintId",
            "in": "path",
            "required": true,
            "description": "Sprint id, like sprint-42",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
